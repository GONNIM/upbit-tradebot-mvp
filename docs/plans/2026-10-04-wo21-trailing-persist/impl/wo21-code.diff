+def get_last_open_buy_trade(user_id: str, ticker: str) -> Optional[Dict[str, Any]]:
+    """
+    ✅ WO-21 (2026-10-04): 보유 포지션의 trailing 재계산 시작점 — audit_trades 의 마지막 BUY
